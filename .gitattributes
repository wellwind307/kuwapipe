# 统一换行符，避免 Windows 上换行被改成 CRLF 污染 diff
* text=auto eol=lf

# 源码按文本处理（GitHub 语言统计与语法高亮依赖这个）
*.v       text
*.vh      text
*.sv      text
*.vhd     text
*.vhdl    text
*.tcl     text
*.xdc     text
*.py      text
*.md      text
*.json    text
*.ipynb   text
*.qsf     text

# Windows 批处理必须用 CRLF，否则个别情况下 cmd 解析异常
*.bat     text eol=crlf
*.cmd     text eol=crlf

# 二进制成品，不做换行转换、不参与 diff
*.bit     binary
*.hwh     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.pdf     binary
*.docx    binary
*.zip     binary

# ---------------------------------------------------------------------------
# GitHub 语言统计修正
#   本仓库里 IP 打包产生的 .xml / .html 数量远多于 RTL，GitHub 会把项目语言
#   误标成 HTML。把第三方 IP 仓库与 BD 自动生成的 IP 目录标为 vendored /
#   generated，语言统计就会回到 Verilog / VHDL（真正的源码）。
#   （目录已按竞赛结构重排：ip_repo_local / base.srcs 现在都在 src/ 下）
# ---------------------------------------------------------------------------
src/ip_repo_local/**                     linguist-vendored=true
src/base.srcs/sources_1/bd/base/ip/**    linguist-generated=true
src/base.srcs/sources_1/bd/mref/**       linguist-generated=true
